# Copie para .env (na raiz) e preencha. Usado pelo compose.yaml.

# ---------------------------------------------------------------- Frontend
# URL do projeto Supabase, ex.: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Chave PÚBLICA: "anon public" (eyJ...) ou "Publishable key" (sb_publishable_...).
# NUNCA use a service_role nem a Secret key (sb_secret_...).
VITE_SUPABASE_ANON_KEY=

# URL base da API do backend, sem barra no final. Fica visível no navegador.
VITE_API_URL=http://localhost:8000
